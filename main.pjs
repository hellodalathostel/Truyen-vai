CanhBdsm() =>
  return [
    { id: "phong-rieng", ten: "Phòng riêng ở câu lạc bộ", moTa: "Cách âm, đèn vàng, một chiếc ghế da, đạo cụ xếp gọn trên kệ — mọi thứ đều được hỏi trước khi dùng." },
    { id: "nha-rieng", ten: "Nhà riêng của chủ nhân", moTa: "Không gian riêng tư, không có ai làm phiền, luật lệ chỉ do hai người đặt ra." },
    { id: "phu-quy-toc", ten: "Phủ đệ cổ trang", moTa: "Đêm khuya, nến, người hầu đã lui. Quyền lực đến từ địa vị, nhưng sự cho phép đến từ cái gật đầu của người chơi." },
    { id: "phong-ngu", ten: "Phòng ngủ riêng", moTa: "Giường lớn, ga sạch, cửa khoá, đèn ngủ mờ — nơi mọi thứ dừng lại khi cần và cũng là nơi kết thúc bằng chăm sóc sau." },
    { id: "phong-tam", ten: "Phòng tắm hơi nước", moTa: "Hơi nước che mờ gương, sàn đá lạnh, nước ấm — cơ thể dễ mềm và dễ bị giữ hơn." },
    { id: "xuong-lam-viec", ten: "Xưởng / tầng hầm", moTa: "Bê tông, bóng đèn trần, dụng cụ treo trên tường, tiếng ồn của thành phố ở trên đầu." },
    { id: "thu-phong", ten: "Thư phòng nhiều sách", moTa: "Giấy, mực, kệ cao, cửa gỗ dày. Sự trang trọng của căn phòng làm mệnh lệnh nặng ký hơn." },
    { id: "phong-giam", ten: "Phòng giam cải tạo", moTa: "Cửa sắt, ánh sáng gắt, một sổ ghi hình phạt. Mọi hình phạt đều có số và có giới hạn." },
    { id: "khach-san", ten: "Phòng khách sạn xa lạ", moTa: "Không ai biết hai người ở đây. Chỉ có một tối, một căn phòng, và một giao kèo sẽ hết hạn lúc bình minh." },
    { id: "khu-rung-dem", ten: "Khu rừng / bãi biển đêm", moTa: "Trời tối, gió lạnh, tiếng nước. Người chơi bị săn đuổi trong một khu vực đã được giới hạn trước." },
    { id: "khao-sat", ten: "Buổi thương lượng đầu tiên", moTa: "Chưa có cảnh nào. Chỉ có hai người ngồi đối diện, hỏi và trả lời về giới hạn, mong muốn, và an toàn." },
    { id: "sau-canh", ten: "Chăm sóc sau", moTa: "Cảnh đã dừng. Chăn, nước, thuốc, im lặng, và một bàn tay vẫn còn đặt trên lưng." },
    { id: "truoc-guoong", ten: "Trước gương", moTa: "Người chơi bị buộc phải nhìn thấy chính mình trong lúc cảnh diễn ra." },
    { id: "buoi-trinh-dien", ten: "Buổi trình diễn có khán giả", moTa: "Có người được mời đứng xem, nhưng khán giả chỉ nhìn và im lặng — mọi quyết định vẫn thuộc về người nắm quyền." },
  ];

