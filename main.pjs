// ==========================================================================
//  TRUYỆN VAI — sổ tay nhập vai đa nhân vật (tiếng Việt)
//
//  File này là "bảng điều khiển" của ứng dụng: import plugin, cấu hình,
//  và các bộ dữ liệu mẫu (thể loại, mẫu nhân vật, mẫu cốt truyện).
//  Toàn bộ giao diện + logic nằm trong index.html và thư mục src/.
//
//  Muốn đổi hành vi của app? Sửa CauHinh() bên dưới.
//  Muốn đổi nội dung gợi ý? Sửa TheLoai() / MauNhanVat() / MauCotTruyen().
// ==========================================================================

aiTextPlugin = {import:ai-text-plugin}
kv = {import:kv-plugin}
textToImagePlugin = {import:text-to-image-plugin} // để tạo ảnh đại diện cho nhân vật

$meta
  title = Truyện Vai — Nhập vai đa nhân vật, group chat, cốt truyện nhiều chương
  description = Tự tay dệt nên cốt truyện nhập vai của riêng bạn: bạn là người chơi duy nhất, trò chuyện với nhiều nhân vật AI, gom họ lại thành group chat, và đẩy câu chuyện đi qua từng chương. Miễn phí, không cần đăng nhập, dữ liệu lưu ngay trên máy bạn.
  image = https://user.uploads.dev/file/701cfc02ee17bf62826d92947e279e5e.jpg
  tags = nhập vai, roleplay, cốt truyện, nhân vật, group chat, tiếng việt, ai, truyện
  header
    mode = minimal

// --------------------------------------------------------------------------
//  CẤU HÌNH — sửa trực tiếp các con số ở đây
// --------------------------------------------------------------------------
CauHinh() =>
  return {
    soTinNhanGiuNguyenVan: 36,   // số tin nhắn gần nhất luôn được gửi nguyên văn cho AI
    tyLeNguongTomTat: 0.7,       // khi ngữ cảnh vượt tỉ lệ này của giới hạn thì nén bớt phần cũ
    soNguoiTraLoiToiDa: 3,       // cảnh nhóm: bộ điều phối tự chọn từ 1 tới tối đa bao nhiêu nhân vật phản hồi một lượt
    soTuGoiY: 3,                 // số gợi ý câu thoại cho người chơi
    doDaiMoTaNhanVatKhac: 90,    // ký tự mô tả ngắn cho các nhân vật không tham gia hội thoại
    luuToiDaTinNhan: 4000,       // giới hạn cứng số tin nhắn lưu mỗi hội thoại (an toàn bộ nhớ)
    soTinNhanQuetLore: 8,        // sổ tri thức: dò từ khoá trong bao nhiêu tin nhắn gần nhất
    nganSachKyTuLore: 4000,      // sổ tri thức: tổng ký tự tối đa chèn vào một prompt
    soKyTuMoiMucLore: 1500,      // sổ tri thức: mục dài hơn thì cắt bớt khi gửi cho AI
    soKyTuMoiDoanTomTat: 14000,  // đoạn dài hơn sẽ được tóm tắt thành nhiều lượt rồi gộp dần (không bỏ sót đoạn giữa)
    soTinNhanGiuLaiKhiKetChuong: 8, // kết chương: số tin cuối giữ nguyên văn, phần trước gộp thành tóm tắt liên tục
  };

// --------------------------------------------------------------------------
//  HAI CÁCH DỰNG CỐT TRUYỆN
// --------------------------------------------------------------------------
MauCotTruyen() =>
  return [
    {
      id: "chuong",
      emoji: "📖",
      ten: "Một cốt truyện, nhiều chương",
      moTa: "Câu chuyện tiến triển theo từng chương nối tiếp. Mỗi chương có mục tiêu riêng, và khi bạn kết chương, AI sẽ viết bản tóm tắt rồi ghi những sự kiện quan trọng vào biên niên sử để các chương sau vẫn nhớ.",
      diem: [
        "Mạch truyện liền lạch, luôn biết mình đang ở đâu",
        "Nút kết chương tự tạo tóm tắt và gợi ý chương kế tiếp",
        "Hợp để chơi một bộ truyện dài kỳ",
      ],
    },
    {
      id: "songSong",
      emoji: "🧵",
      ten: "Nhiều hội thoại theo cốt truyện",
      moTa: "Một thế giới, nhiều tuyến hội thoại song song. Bạn trò chuyện riêng với từng nhân vật, gom vài người lại thành group chat, tất cả cùng chia sẻ bối cảnh và biên niên sử của truyện.",
      diem: [
        "Tự do nhảy giữa các nhân vật và các tuyến truyện",
        "Mỗi hội thoại có trí nhớ riêng nhưng dùng chung bối cảnh",
        "Hợp để khám phá thế giới và quan hệ giữa các nhân vật",
      ],
    },
  ];

// --------------------------------------------------------------------------
//  THỂ LOẠI — dùng cho bước tạo cốt truyện và cho nút gợi ý của AI
// --------------------------------------------------------------------------
TheLoai() =>
  return [
    { id: "tien-hiep", emoji: "⛰️", ten: "Tu tiên", khongKhi: "huyền bí, khắc khổ, tranh đấu giữa các tông môn", goiY: "Linh khí đang hồi phục sau ngàn năm suy tàn. Các tông môn tranh nhau những di tích cổ, còn tán tu như bạn phải tự tìm con đường của mình." },
    { id: "kiem-hiep", emoji: "🗡️", ten: "Kiếm hiệp", khongKhi: "giang hồ ân oán, trọng nghĩa khinh tài", goiY: "Võ lâm chia năm xẻ bảy sau cái chết của Minh chủ. Một thanh kiếm gãy, một lời thề cũ, và những kẻ không muốn ngươi sống để kể lại." },
    { id: "ky-ao", emoji: "🐉", ten: "Kỳ ảo (Fantasy)", khongKhi: "phiêu lưu, sử thi, phép thuật", goiY: "Vương quốc Alden đang mất dần ánh sáng khi Ma Vương thức giấc. Những người cuối cùng còn giữ lời thề hộ quốc đang tập hợp." },
    { id: "hoc-vien", emoji: "🪄", ten: "Học viện phép thuật", khongKhi: "tuổi trẻ, thi cử, tình bạn, bí mật học đường", goiY: "Học viện Aethel mở cửa mỗi mười năm một lần. Năm nay có một học sinh nhập học với sức mạnh không ai giải thích được — và một giáo sư đang cố che giấu nó." },
    { id: "hoc-duong", emoji: "🎒", ten: "Học đường", khongKhi: "trong trẻo, câu lạc bộ, mối tình đầu, mùa thi", goiY: "Học kỳ cuối cấp bắt đầu. Câu lạc bộ của bạn đứng trước nguy cơ giải thể, và người bạn thân nhất vừa chuyển tới ngồi cạnh bạn." },
    { id: "do-thi", emoji: "🏙️", ten: "Đô thị hiện đại", khongKhi: "đời thường, công sở, chữa lành", goiY: "Một căn hộ nhỏ ở tầng 12, một công việc vừa đủ sống, và những người hàng xóm hoá ra thú vị hơn bạn tưởng." },
    { id: "scifi", emoji: "🚀", ten: "Khoa học viễn tưởng", khongKhi: "lạnh lẽo, vĩ đại, cô đơn giữa vũ trụ", goiY: "Trạm nghiên cứu Kepler-9 mất liên lạc với Trái Đất đã 400 ngày. Trong khoang số 3, một thứ gì đó đang học cách nói tiếng người." },
    { id: "cyberpunk", emoji: "🌃", ten: "Cyberpunk", khongKhi: "neon, mưa axit, tập đoàn, nổi loạn", goiY: "Thành phố Tân Sài Gòn 2099: hầm chui, chợ đen, và những tập đoàn mua bán ký ức. Bạn là một thợ sửa chip với món nợ không thể trả." },
    { id: "hau-tan-the", emoji: "☢️", ten: "Hậu tận thế", khongKhi: "sinh tồn, tàn khốc, hy vọng mong manh", goiY: "Bảy năm sau ngày Vỡ, mưa vẫn rơi đầy bụi. Nhóm của bạn còn ba lon đào và một chiếc radio có thể đang phát tín hiệu từ vùng an toàn." },
    { id: "trinh-tham", emoji: "🔍", ten: "Trinh thám / Hình sự", khongKhi: "căng thẳng, logic, manh mối rải rác", goiY: "Một vụ mất tích không thi thể, một nhân chứng nói dối quá hoàn hảo, và một hồ sơ cũ mà ai đó đã cố đốt." },
    { id: "kinh-di", emoji: "🕯️", ten: "Kinh dị", khongKhi: "ngột ngạt, bất an, cái ác vô hình", goiY: "Ngôi nhà cổ ở cuối làng được thừa kế cùng một điều kiện: không bao giờ mở cánh cửa cuối hành lang sau nửa đêm." },
    { id: "xuyen-khong", emoji: "🌀", ten: "Xuyên không / Isekai", khongKhi: "choáng ngợp, hài hước, khám phá", goiY: "Bạn tỉnh dậy trong một thế giới không có điện, không có giấy tờ, và một 'kỹ năng' duy nhất mà hệ thống không chịu giải thích." },
    { id: "cung-dau", emoji: "🏯", ten: "Cung đấu cổ trang", khongKhi: "quyền mưu, lễ nghi, dao găm giấu trong tay áo", goiY: "Hậu cung có mười hai vị nương nương và mười một người đang tính đường sống sót qua mùa đông này." },
    { id: "lich-su-viet", emoji: "🏮", ten: "Lịch sử Việt Nam", khongKhi: "hào sảng, thân thuộc, bi tráng", goiY: "Một làng chài ven biển, một ông đồ già, một đoàn thuyền lạ ngoài khơi, và mùa thi Hương đang tới gần." },
    { id: "sieu-anh-hung", emoji: "🦸", ten: "Siêu anh hùng", khongKhi: "hiện đại, kịch tính, trách nhiệm", goiY: "Thành phố có bảy siêu anh hùng được cấp phép, và bạn vừa phát hiện mình là người thứ tám — không có giấy phép." },
    { id: "showbiz", emoji: "🎤", ten: "Showbiz / Idol", khongKhi: "hào nhoáng, scandal, áp lực", goiY: "Nhóm nhạc của bạn vừa nổi sau một bản hit, và ngay lập tức một đoạn ghi âm bị rò rỉ ra ngoài." },
    { id: "lang-man", emoji: "🍂", ten: "Lãng mạn đời thường", khongKhi: "chậm rãi, ấm áp, day dứt nhẹ", goiY: "Một quán cà phê cũ, một người khách quen luôn gọi đúng một món, và một cuốn sổ bị bỏ quên trên bàn." },
    { id: "huyen-bi", emoji: "🌫️", ten: "Huyền bí đời thường", khongKhi: "kỳ lạ len vào thường ngày", goiY: "Thế giới này bình thường — chỉ có điều thỉnh thoảng có người bước vào một con hẻm và không bước ra ở cùng thành phố." },
    { id: "bdsm-mm", emoji: "⛓️", ten: "BDSM M/M — trao đổi quyền lực", khongKhi: "căng thẳng được kiểm soát, tin cậy tuyệt đối, dịu dàng sau bạo liệt", bdsm: true, kieuQuanHe: "chu-to", goiY: "Một căn phòng riêng ở tầng hầm câu lạc bộ, một bản giao kèo đặt trên bàn mà chưa ai ký, và một người đàn ông luôn biết chính xác bạn chịu được tới đâu." },
    { id: "bdsm-co-trang", emoji: "🏮", ten: "Chủ tớ cổ trang M/M", khongKhi: "quyền lực tuyệt đối, lễ nghi, khao khát bị che giấu sau lớp áo", bdsm: true, kieuQuanHe: "chu-to-co-trang", goiY: "Ngươi được nhận vào phủ làm kẻ hầu cận của một vị chủ nhân trẻ tuổi — nghiêm khắc, công bằng, và tàn nhẫn theo một cách không ai dám gọi tên." },
    { id: "bdsm-club", emoji: "🌃", ten: "Câu lạc bộ kín M/M", khongKhi: "nhạc trầm, mặt nạ, luật lệ rõ ràng, tò mò bị giữ lại", bdsm: true, kieuQuanHe: "the-gioi-mo", goiY: "Câu lạc bộ chỉ mở cửa cho người được giới thiệu. Bạn bước vào lần đầu — và người đứng ở cửa đã biết tên bạn, dù bạn chưa từng nói với ai." },
    { id: "bdsm-trai-huan-luyen", emoji: "📏", ten: "Trại huấn luyện M/M", khongKhi: "kỷ luật, thời khoá biểu, sự phục tùng được rèn từng ngày", bdsm: true, kieuQuanHe: "huan-luyen", goiY: "Trại nằm trên núi, không sóng điện thoại. Học viên mới phải qua ba mươi ngày rèn luyện, và người huấn luyện của bạn không tin vào lời hứa — chỉ tin vào kết quả." },
    { id: "bdsm-benh-vien", emoji: "🩺", ten: "Bác sĩ & bệnh nhân M/M", khongKhi: "ánh đèn trắng, mùi cồn, quyền lực khoác áo y khoa", bdsm: true, kieuQuanHe: "bac-si", goiY: "Phòng khám tư chỉ nhận một bệnh nhân mỗi tối. Bác sĩ điều trị cho bạn bằng một phác đồ không có trong bất kỳ sách y khoa nào." },
    { id: "bdsm-nha-tu", emoji: "🔒", ten: "Nhà tù & cai ngục M/M", khongKhi: "khép kín, luật lệ, hình phạt có sổ sách", bdsm: true, kieuQuanHe: "cai-nguc", goiY: "Khu giam đặc biệt chỉ có một phòng. Cai ngục trẻ tuổi vừa nhận ca trực đầu tiên — và người tù duy nhất trong phòng biết rõ hơn ai hết cách làm anh ta mất bình tĩnh." },
    { id: "bdsm-ma-ca-rong", emoji: "🦇", ten: "Chủ nhân bóng tối M/M", khongKhi: "đêm, máu, sự vĩnh hằng, khao khát bị che giấu", bdsm: true, kieuQuanHe: "ma-ca-rong", goiY: "Người đó đã sống bốn trăm năm và chưa từng giữ ai lại quá một mùa. Năm nay, hắn quyết định sẽ giữ bạn — nếu bạn chịu ký một giao kèo." },
    { id: "bdsm-pet", emoji: "🐾", ten: "Thú cưng & chủ nhân M/M", khongKhi: "mềm mại, được nuông chiều, vòng cổ và mệnh lệnh dịu dàng", bdsm: true, kieuQuanHe: "thu-cung", goiY: "Trong căn hộ đó có một góc trải thảm, một chiếc vòng cổ khắc tên, và một người đàn ông luôn biết chính xác khi nào bạn cần được khen." },
    { id: "bdsm-sat-thu", emoji: "🗡️", ten: "Sát thủ & con tin M/M", khongKhi: "căng thẳng, tin cậy mong manh, quyền lực đổi chiều", bdsm: true, kieuQuanHe: "chiem-huu", goiY: "Bạn tỉnh dậy trong một căn phòng không có cửa sổ, tay bị trói bằng dây da. Kẻ ngồi đối diện nói rằng hắn không được trả tiền để giết bạn — chỉ để giữ bạn." },
    { id: "bdsm-cung-dinh", emoji: "👑", ten: "Quý tộc & thị vệ M/M", khongKhi: "lễ nghi, khao khát bị nén sau lớp áo gấm", bdsm: true, kieuQuanHe: "hoang-tu", goiY: "Người thị vệ trẻ quỳ trước mặt bạn trong đêm thứ ba liên tiếp, và lần này anh ta không xin lỗi nữa." },
  ];

// --------------------------------------------------------------------------
//  LỚP "GIAO KÈO" — trao đổi quyền lực có thoả thuận (BDSM / Dom–sub)
//  Đây là phần giúp AI viết sâu và an toàn: vai của người chơi, từ khoá dừng,
//  giới hạn, mức độ, chăm sóc sau. Bật/tắt được cho từng cốt truyện.
// --------------------------------------------------------------------------
GiaoKeoMacDinh() =>
  return {
    bat: false,
    vaiNguoiChoi: "sub",          // "dom" | "sub" | "switch"
    tuKhoaDung: "đỏ",             // người chơi nói từ này là cảnh dừng ngay
    kieuQuanHe: "",               // id trong KieuQuanHe() — khung quan hệ của cảnh
    mucDo: 3,                     // 1..5 — xem MucDoBdsm()
    nhipDo: "theo-dien-bien",     // id trong NhipDoBdsm() — cách cảnh đi nhanh hay chậm
    doDai: "vua",                 // id trong DoDaiCanh() — một cảnh dài bao nhiêu
    ngonNgu: "tu-nhien",          // id trong NgonNguBdsm() — độ trần trụi của ngôn từ
    soThich: [],                  // id trong SoThichBdsm() — điều người chơi muốn có trong cảnh
    gioiHanCung: "",              // tuyệt đối không xuất hiện, kể cả nhắc tới
    gioiHanMem: "",               // chỉ chạm tới nếu có thoả thuận trước trong cảnh
    khongKhi: "",                 // bối cảnh riêng của cảnh (phòng, đạo cụ, không khí)
    danhXung: "",                 // cách gọi nhau trong cảnh
    luatCanh: "",                 // luật riêng luôn đúng trong mọi cảnh của truyện này
    chamSocSau: "",               // người chơi muốn được chăm sóc thế nào
    luuY: "",                     // dặn dò riêng của người chơi cho AI
  };

// Khung quan hệ / nhập vai quyền lực — chọn một, AI sẽ giữ đúng cấu trúc này.
KieuQuanHe() =>
  return [
    { id: "chu-to", emoji: "⛓️", ten: "Chủ nhân – tớ", vaiMacDinh: "sub", moTa: "Một bên sở hữu và chịu trách nhiệm, một bên thuộc về và được giữ. Quyền lực tuyệt đối nhưng có luật.", goiY: "Phòng riêng, đèn vàng, một bản giao kèo đã ký." },
    { id: "chu-to-co-trang", emoji: "🏮", ten: "Chủ nhân – người hầu (cổ trang)", vaiMacDinh: "sub", moTa: "Địa vị quyết định quyền lực: chủ nhân ra lệnh, người hầu phụng sự, nhưng sự cho phép vẫn đến từ người trao quyền.", goiY: "Đêm khuya, nến, người hầu đã lui, áo lụa và lễ nghi." },
    { id: "thay-tro", emoji: "📏", ten: "Thầy – trò", vaiMacDinh: "sub", moTa: "Một bên dạy và uốn nắn, một bên học bằng kỷ luật, lặp lại và sửa sai. Sai thì có hình phạt được đếm rõ.", goiY: "Lớp học riêng, bảng đen, thước kẻ, sổ theo dõi buổi học." },
