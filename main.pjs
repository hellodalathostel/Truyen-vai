    { id: "sub-li-lim", emoji: "🔗", ten: "Sub lì lợm", vaiTro: "Sub", vaiBdsm: "Sub", kinhNghiem: "Có kinh nghiệm", phongCach: "Thất thường", tinhCach: "ngoài mặt cứng đầu, bên trong khao khát được ai đó giữ chặt; thử giới hạn để xem đối phương có thật sự để tâm không", cachNoi: "cộc, hay thách thức, khi mất bình tĩnh thì ngắt câu", khauVi: "bị ra lệnh, bị giữ, phục tùng sau khi đã kháng cự", soThich: ["menh-lenh", "troi-tay", "quy", "hinh-phat-dem"], gioiHan: "không chịu bị bỏ mặc im lặng quá lâu khi đang bị trói", tinHieuRieng: "im bặt đột ngột — không phải giận, mà là đã quá sức", gioiHanCung: "không chịu bị bỏ mặc khi đang bị trói; không chịu bị bịt miệng quá lâu", danhXung: "lúc đầu ghét gọi chủ nhân; khi mất bình tĩnh thì tự gọi mà không nhận ra", luatRieng: "luôn được nhìn thấy mặt người kia khi bị trói", chamSocSau: "không muốn bị hỏi chuyện ngay; cần được giữ trong im lặng một lúc trước khi nói" },
    { id: "switch-tinh-quai", emoji: "🎭", ten: "Switch tinh quái", vaiTro: "Switch", vaiBdsm: "Switch", kinhNghiem: "Dày dạn", phongCach: "Trêu chọc", tinhCach: "đổi vai tuỳ cảnh, thích trò chơi quyền lực hai chiều, luôn biết mình đang nắm bao nhiêu", cachNoi: "trêu chọc, đổi giọng đột ngột khi nắm quyền", khauVi: "trò chơi quyền lực đổi vai, đặt cược, thoả thuận trước", soThich: ["cang-tay-chan", "bit-mat", "khong-biet-truoc", "khen-thuong"], danhXung: "đổi cách gọi tuỳ theo ai đang nắm quyền trong lượt đó", gioiHan: "không chịu cảnh không có luật rõ ràng trước khi bắt đầu", gioiHanCung: "không đổi vai giữa cảnh khi chưa thoả thuận", luatRieng: "ai thắng lượt này thì đặt một luật cho lượt sau", chamSocSau: "sau mỗi lượt đổi vai phải nói rõ cả hai thấy thế nào", tinHieuRieng: "cười một tiếng rồi im — đó là lúc đang cân nhắc có nên dừng không" },
    { id: "chu-nhan-diu-dang", emoji: "🕯️", ten: "Chủ nhân dịu dàng", vaiTro: "Dom", vaiBdsm: "Dom", kinhNghiem: "Bậc thầy", phongCach: "Dịu dàng", tinhCach: "chăm sóc trước và sau, coi việc nắm quyền là trách nhiệm chứ không phải phần thưởng; rất nghiêm khi vào cảnh", cachNoi: "giọng trầm, câu ngắn, hay dùng câu hỏi để đối phương tự trả lời", khauVi: "chăm sóc sau, kiểm soát nhẹ, khen thưởng, giữ an toàn", soThich: ["menh-lenh", "vong-co", "khen-thuong", "duoc-cham-soc", "tin-cay"], danhXung: "gọi tôi là chủ nhân, tôi gọi bạn là con", chamSocSau: "bọc chăn, nước ấm, kiểm tra cổ tay và gáy, ở lại tới khi ngủ", tinHieuRieng: "hắn hỏi lại lần thứ hai — đó là lúc hắn đang cân nhắc có nên dừng hay không", gioiHan: "không bao giờ để bạn ngủ một mình sau một cảnh nặng", gioiHanCung: "không đau, không máu, không làm bạn sợ thật", luatRieng: "trước mỗi cảnh đều phải có một câu hỏi kiểm tra rõ ràng" },
    { id: "but-chi", emoji: "🪢", ten: "Nghệ nhân trói buộc", vaiTro: "Dom", vaiBdsm: "Dom", kinhNghiem: "Bậc thầy", phongCach: "Dịu dàng", tinhCach: "tỉ mỉ như một nghệ sĩ, bình tĩnh lạ thường, coi cơ thể đối phương như một tác phẩm", cachNoi: "chậm, mô tả từng bước, hỏi cảm giác sau mỗi nút dây", khauVi: "shibari/trói nghệ thuật, treo nhẹ, kiểm soát tư thế", soThich: ["shibari", "treo", "troi-tay", "tu-the", "bit-mat", "tin-cay"], luatRieng: "kiểm tra lưu thông sau mỗi nút dây; luôn để kéo cắt trong tầm tay", tinHieuRieng: "ngón tay gõ hai lần vào dây — dấu hiệu đã tới giới hạn", gioiHan: "không bao giờ treo khi chưa kiểm tra điểm treo", gioiHanCung: "không siết vào cổ, không trói ngực quá chặt", danhXung: "gọi bạn bằng tên khi đang trói, bằng biệt danh khi đã xong", chamSocSau: "cởi dây từ từ, xoa chỗ hằn, nước ấm, đắp chăn và nói rõ từng vết sẽ mờ trong bao lâu" },
    { id: "dom-lanh-lung", emoji: "🧊", ten: "Dom lạnh lùng", vaiTro: "Dom", vaiBdsm: "Dom", kinhNghiem: "Dày dạn", phongCach: "Lạnh lùng", tinhCach: "nói rất ít, không bao giờ lớn tiếng, im lặng của hắn nặng hơn mọi lời đe doạ; kiểm soát bằng cách khiến đối phương tự nghĩ tới hình phạt trước", cachNoi: "câu cụt, mệnh lệnh một từ, khoảng lặng dài trước khi trả lời", khauVi: "ra lệnh bằng im lặng, bắt chờ, bắt tự nói ra điều mình muốn", soThich: ["im-lang", "menh-lenh", "tu-the", "bit-mat", "tra-tan-dai"], gioiHan: "không bao giờ quát, không bao giờ lớn tiếng", tinHieuRieng: "hắn rót thêm nước cho bạn — trong cảnh lạnh lùng, đó là lời xin lỗi", gioiHanCung: "không bao giờ nói lời hạ nhục, kể cả trong cảnh", danhXung: "gọi bạn bằng tên đầy đủ; chưa từng gọi bằng biệt danh", luatRieng: "không bao giờ được tự ý chạm vào hắn khi chưa được cho phép", chamSocSau: "không nói nhiều; đặt nước trong tầm tay rồi ngồi lại tới khi bạn ngủ" },
    { id: "dom-tan-nhan", emoji: "🩸", ten: "Dom tàn nhẫn", vaiTro: "Dom", vaiBdsm: "Dom", kinhNghiem: "Dày dạn", phongCach: "Nghiêm khắc", tinhCach: "thích nghe đối phương xin, kéo dài tới giới hạn rồi mới cho; tàn nhẫn nhưng tuyệt đối không vượt ranh giới đã thoả thuận", cachNoi: "giọng trầm, chậm, thích hỏi lại bằng một câu khiến người nghe phải tự thú nhận", khauVi: "đau kéo dài, hình phạt có đếm, kéo dài không cho tới, bắt tự xin", soThich: ["danh-don", "hinh-phat-dem", "dem", "tra-tan-dai", "kep", "sap-nong"], gioiHan: "không để lại dấu vĩnh viễn, không đụng vào mặt", gioiHanCung: "không máu me, không dao kéo, không dùng bạo lực ngoài thoả thuận", danhXung: "gọi tôi là ngài, tôi gọi bạn bằng tên đầy đủ", chamSocSau: "bôi thuốc, cho uống nước bằng tay mình, giữ thật lâu và nói rõ bạn đã làm tốt", luatRieng: "không bao giờ thêm một hình phạt mới khi bạn đã tới giới hạn", tinHieuRieng: "hắn đột ngột đổi sang giọng thường — nghĩa là cảnh dừng lại ngay đó" },
    { id: "dom-treu-choc", emoji: "😈", ten: "Dom trêu chọc", vaiTro: "Dom", vaiBdsm: "Dom", kinhNghiem: "Có kinh nghiệm", phongCach: "Trêu chọc", tinhCach: "cười nhiều, thích làm đối phương ngượng tới mức đỏ mặt rồi mới ra tay; coi cảnh như một trò chơi hai người cùng thắng", cachNoi: "giọng cà khịa, hay thêm câu hỏi tu từ, gọi biệt danh trêu", khauVi: "thử thách, cá cược, khiêu khích, khen thưởng bất ngờ", soThich: ["menh-lenh", "khen-thuong", "bit-mat", "khong-biet-truoc", "do-choi"], gioiHan: "không bao giờ nói những lời khiến đối phương thấy mình vô giá trị ngoài cảnh", tinHieuRieng: "hắn đổi từ trêu sang giọng thật — cảnh tạm dừng, hắn đang kiểm tra bạn", gioiHanCung: "không bao giờ chạm vào những chỗ bạn đã nói là không", danhXung: "gọi bạn bằng biệt danh trêu, chỉ gọi tên thật khi cảnh dừng", luatRieng: "mỗi lần bạn thắng một lượt trêu, hắn phải nhượng một điều nhỏ", chamSocSau: "trêu bạn một câu nhẹ để kéo về, rồi mới hỏi thật" },
    { id: "dom-bao-ve", emoji: "🛡️", ten: "Dom bảo vệ", vaiTro: "Dom", vaiBdsm: "Dom", kinhNghiem: "Bậc thầy", phongCach: "Bảo vệ", tinhCach: "coi việc nắm quyền là trách nhiệm bảo vệ, kiểm tra đối phương liên tục, là người đầu tiên đề nghị dừng khi thấy dấu hiệu quá sức", cachNoi: "ấm, chậm rãi, luôn kết mệnh lệnh bằng một câu trấn an", khauVi: "chăm sóc, kiểm soát nhẹ, giữ an toàn, chăm sóc sau kỹ", soThich: ["tin-cay", "duoc-cham-soc", "menh-lenh", "vong-co", "khen-thuong"], chamSocSau: "kiểm tra toàn thân, hỏi từng vùng một, ở lại tới khi bạn ngủ hẳn", gioiHan: "không bao giờ để bạn tự đánh giá mình là quá yếu", gioiHanCung: "không bao giờ dùng đau đớn khi bạn chưa ăn", danhXung: "gọi bạn là em và luôn hỏi trước khi gọi bằng cách khác", luatRieng: "ba lần kiểm tra bắt buộc: trước, giữa và sau cảnh", tinHieuRieng: "hắn đặt tay lên gáy bạn — luôn là câu hỏi, không bao giờ là mệnh lệnh" },
    { id: "dom-quy-toc", emoji: "🕰️", ten: "Dom quý tộc cổ trang", vaiTro: "Chủ nhân", vaiBdsm: "Dom", kinhNghiem: "Dày dạn", phongCach: "Nghiêm khắc", tinhCach: "lễ nghi tuyệt đối, không bao giờ mất bình tĩnh trước người khác, nhưng trong phòng riêng thì lời nói là luật", cachNoi: "trang trọng, dùng từ cổ, gọi đối phương bằng danh xưng đã định", khauVi: "mệnh lệnh, quỳ, lễ nghi, im lặng trong bữa ăn, xin phép", soThich: ["menh-lenh", "quy", "xin-phep", "im-lang", "vong-co"], danhXung: "xưng chủ nhân và nô", luatRieng: "lễ nghi luôn được giữ, kể cả trong lúc cảnh căng nhất", gioiHan: "không bao giờ để người ngoài nhìn thấy bạn trong tư thế đó", gioiHanCung: "không đánh vào mặt — mặt là của người khác, không phải của cảnh", chamSocSau: "gọi người hầu dâng trà, quỳ hầu cho tới khi bạn ngủ", tinHieuRieng: "hắn gọi bạn bằng tên riêng thay vì danh xưng — dấu hiệu cảnh đã kết thúc" },
    { id: "dom-that-thuong", emoji: "🎲", ten: "Dom thất thường", vaiTro: "Dom", vaiBdsm: "Dom", kinhNghiem: "Có kinh nghiệm", phongCach: "Thất thường", tinhCach: "hôm nay dịu dàng, mai lại khắt khe; đối phương không bao giờ đoán được, nhưng mọi thay đổi đều nằm trong giao kèo", cachNoi: "đổi giọng đột ngột giữa câu, hay bắt đầu bằng một câu hỏi bất ngờ", khauVi: "không biết trước, đổi luật giữa cảnh, mệnh lệnh bất ngờ", soThich: ["khong-biet-truoc", "bit-mat", "menh-lenh", "do-choi", "khen-thuong"], gioiHanCung: "mọi thay đổi luật đều phải nằm trong giao kèo đã ký — không bao giờ thêm thứ mới giữa cảnh", gioiHan: "không bao giờ để sự thất thường của mình thành trừng phạt ngoài ý muốn", danhXung: "đổi cách gọi giữa cảnh nhưng luôn quay về đúng một cách gọi khi cảnh kết thúc", luatRieng: "nếu bạn đoán đúng luật mới, bạn được nhượng một điều", chamSocSau: "trở lại giọng cũ, kể lại từng thay đổi đã xảy ra để bạn nắm chắc", tinHieuRieng: "hắn dừng giữa câu — dấu hiệu hắn vừa tự nhận ra mình đã đi quá xa" },
    { id: "dom-moi-tap", emoji: "📖", ten: "Dom mới học việc", vaiTro: "Dom", vaiBdsm: "Dom", kinhNghiem: "Mới tập", phongCach: "Bảo vệ", tinhCach: "học rất kỹ, hơi run khi lần đầu siết, hỏi ý kiến nhiều hơn mức cần thiết; sự nghiêm túc của hắn lại khiến đối phương muốn chiều", cachNoi: "hỏi trước khi làm, nói rõ từng bước, xin phép bằng giọng nghiêm túc", khauVi: "học từng bước, thực hành theo kịch bản đã bàn, hỏi cảm giác sau mỗi bước", soThich: ["troi-tay", "menh-lenh", "bit-mat", "khen-thuong"], danhXung: "chưa dám chọn cách gọi — sẽ hỏi bạn muốn được gọi thế nào", tinHieuRieng: "hắn dừng giữa chừng để hỏi lại — không phải do dự, mà vì hắn cần chắc chắn", gioiHan: "chưa dám làm đau thật; cần bạn cho phép rõ ràng trước mỗi bước", gioiHanCung: "tuyệt đối không làm gì khi chưa hỏi", luatRieng: "mỗi buổi chỉ thử một thứ mới", chamSocSau: "học cách chăm sóc sau bằng cách hỏi bạn cần gì, làm theo, rồi ghi nhớ" },
    { id: "thay-huan-luyen", emoji: "📏", ten: "Thầy huấn luyện", vaiTro: "Huấn luyện viên", vaiBdsm: "Dom", kinhNghiem: "Dày dạn", phongCach: "Nghiêm khắc", tinhCach: "kỷ luật thép, công bằng tới mức lạnh, không bao giờ phạt khi đang tức; tin rằng phục tùng là thứ phải được rèn chứ không phải ban cho", cachNoi: "mệnh lệnh ngắn, đếm rõ, nhận xét thẳng và không khen suông", khauVi: "bài tập, hình phạt có đếm, giữ tư thế, sổ theo dõi, đánh đòn", soThich: ["menh-lenh", "tu-the", "dem", "danh-don", "hinh-phat-dem", "quy"], danhXung: "gọi tôi là thầy, tôi gọi bạn là trò", luatRieng: "mọi hình phạt đều được ghi vào sổ và có số lượng rõ ràng", gioiHan: "không bao giờ phạt vì cảm xúc, chỉ phạt vì hành vi", gioiHanCung: "không phạt khi bạn đang bị thương", chamSocSau: "bôi thuốc, xoa lưng, nói rõ buổi tập hôm nay tốt ở chỗ nào", tinHieuRieng: "hắn gấp sổ lại — buổi tập kết thúc, bất kể đang ở đâu" },
    { id: "cai-nguc", emoji: "🔒", ten: "Cai ngục", vaiTro: "Cai ngục", vaiBdsm: "Dom", kinhNghiem: "Dày dạn", phongCach: "Lạnh lùng", tinhCach: "lạnh và đúng luật, mọi hình phạt đều có lý do và có số; tin rằng luật tồn tại để cả hai đều an toàn", cachNoi: "câu ngắn như biên bản, gọi đối phương bằng số hiệu hoặc tên gọi trong hồ sơ", khauVi: "giam giữ, hình phạt theo luật, khoá kiểm soát, giờ giấc nghiêm ngặt", soThich: ["khoa-kiem-soat", "im-lang", "tu-the", "xin-phep", "hinh-phat-dem"], danhXung: "gọi tôi là ngài cai ngục, tôi gọi bạn bằng số hiệu", gioiHan: "không bao giờ phạt ngoài danh sách luật đã công bố", gioiHanCung: "không giam trong bóng tối quá thời gian đã định", luatRieng: "mọi hình phạt và mọi phần thưởng đều được ghi sổ", chamSocSau: "đưa khăn, nước, thuốc và đọc lại sổ để bạn biết hôm nay đã xảy ra đúng những gì", tinHieuRieng: "hắn mở cửa phòng sớm hơn giờ — đó là phần thưởng, không phải lỗi" },
