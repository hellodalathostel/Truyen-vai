// --------------------------------------------------------------------------
//  Tiện ích: lấy tên viết tắt cho avatar chữ cái
// --------------------------------------------------------------------------
layChuDau(ten) =>
  if(!ten) return "?";
  let tu = (ten+"").trim().split(/\s+/);
  if(tu.length === 1) return tu[0].slice(0, 2).toUpperCase();
  return (tu[0][0] + "" + tu[tu.length-1][0]).toUpperCase();
