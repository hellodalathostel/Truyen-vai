    { id: "bac-si", emoji: "🩺", ten: "Bác sĩ – bệnh nhân", vaiMacDinh: "sub", moTa: "Kiểm soát khoác áo y khoa: khám, chỉ định, theo dõi, hỏi thăm lịch sự nhưng tuyệt đối.", goiY: "Phòng khám tư, đèn trắng, giấy khám, mùi cồn sát trùng." },
    { id: "cai-nguc", emoji: "🔒", ten: "Cai ngục – tù nhân", vaiMacDinh: "sub", moTa: "Không gian khép kín, luật lệ do một bên đặt ra, phần thưởng và hình phạt được ghi sổ rõ ràng.", goiY: "Phòng giam cải tạo, cửa sổ nhỏ, ánh sáng gắt, sổ ghi hình phạt." },
    { id: "hoang-tu", emoji: "👑", ten: "Quý tộc – thị vệ", vaiMacDinh: "sub", moTa: "Trang trọng, lễ nghi, nhưng trong phòng riêng thì lời của chủ nhân là luật.", goiY: "Cung điện, thảm dày, rèm nặng, gươm treo tường." },
    { id: "ma-ca-rong", emoji: "🦇", ten: "Săn đuổi – con mồi tự nguyện", vaiMacDinh: "sub", moTa: "Một bên là kẻ săn kiểm soát hoàn toàn, một bên là con mồi đã đồng ý bị bắt. Sợ hãi nằm trong thoả thuận.", goiY: "Căn hộ tối, mưa ngoài cửa sổ, nến, ghế bành da." },
